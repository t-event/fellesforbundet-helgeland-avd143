---
import Layout from '../layouts/Layout.astro';
import CircleMotif from '../components/CircleMotif.astro';
import Icon from '../components/Icon.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { KONTAKT, KONTORER } from '../config.ts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Lokalkontorene (alle unntatt hovedkontoret, som har sin egen boks over).
const lokalkontor = KONTORER.filter(k => !k.hovedkontor);
const kartUrl = (k: typeof KONTORER[number]) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${k.adresse}, ${k.postnummer} ${k.poststed}`)}`;
const mapQuery = `${KONTAKT.adresse}, ${KONTAKT.postnummer} ${KONTAKT.poststed}`;
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
// Keyless Google Maps-embed (ingen API-nøkkel) — Google geokoder adressen presist.
const googleEmbed = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&hl=no&z=16&t=k&output=embed`;
---

<Layout
  title="Kontakt — Fellesforbundet Helgeland avd. 143"
  titleEn="Contact — Fellesforbundet Helgeland branch 143"
  description="Kontakt Fellesforbundet avd. 143. Kontorer i Mo i Rana, Sandnessjøen og Mosjøen. Ring 75 15 12 28 eller send oss en melding."
>

  <!-- HERO -->
  <div class="hero-dark">
    <CircleMotif variant="mork-rod" class="hero-motif" />
    <div class="container section">
      <span class="hero-pill" data-en="Contact">Kontakt</span>
      <h1 class="h1" style="max-width:16ch; margin-top:18px;" data-en="Get in touch with the branch">Ta kontakt med avdelingen</h1>
      <p class="lead" style="max-width:56ch; margin-top:20px;"
         data-en="Visit us in Mo i Rana, Sandnessjøen or Mosjøen, give us a call or send a message — we're here for the members.">
        Besøk oss i Mo i Rana, Sandnessjøen eller Mosjøen, ring oss eller send en melding — vi er her
        for medlemmene.
      </p>
    </div>
  </div>

  <div class="container section">
    <div class="grid grid-2" style="gap:clamp(28px,4vw,48px); align-items:start;">

      <!-- KONTAKTINFO -->
      <div>
        <span class="eyebrow" data-en="Contact information">Kontaktinformasjon</span>
        <h2 class="h2" style="font-size:clamp(22px,2.6vw,30px); margin:6px 0 22px;" data-en="The branch office">Avdelingskontoret</h2>
        <div style="display:flex; flex-direction:column; gap:18px;">
          <div>
            <b style="font-size:14px;" data-en="Address">Adresse</b>
            <p class="muted" style="font-size:15px; margin-top:2px;">
              {KONTAKT.adresse}, {KONTAKT.postnummer} {KONTAKT.poststed}<br />
              <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn-link" style="font-size:14px;" data-en="Show on map ↗">Vis i kart ↗</a>
            </p>
          </div>
          <div>
            <b style="font-size:14px;" data-en="Phone">Telefon</b>
            <p style="font-size:15px; margin-top:2px;"><a href={`tel:+47${KONTAKT.telefon}`} class="btn-link">{KONTAKT.telefonFormatert}</a></p>
          </div>
          <div>
            <b style="font-size:14px;" data-en="Email">E-post</b>
            <p style="font-size:15px; margin-top:2px;"><a href={`mailto:${KONTAKT.epost}`} class="btn-link">{KONTAKT.epost}</a></p>
          </div>
          <div>
            <b style="font-size:14px;" data-en="Opening hours">Åpningstider</b>
            <p class="muted" style="font-size:15px; margin-top:2px;">{KONTAKT.apningstider}</p>
          </div>
          <div>
            <b style="font-size:14px;" data-en="Facebook">Facebook</b>
            <p style="font-size:15px; margin-top:2px;"><a href={KONTAKT.facebookUrl} target="_blank" rel="noopener noreferrer" class="btn-link" data-en="Follow the branch ↗">Følg avdelingen ↗</a></p>
          </div>
          <div>
            <b style="font-size:14px;" data-en="Org. number">Org.nr.</b>
            <p class="muted" style="font-size:15px; margin-top:2px;">
              <a href={KONTAKT.brreg} target="_blank" rel="noopener noreferrer" class="btn-link" style="font-weight:normal;">{KONTAKT.orgnr} ↗</a>
            </p>
          </div>
        </div>

        <!-- KART — samtykke-styrt Google Maps-embed + lenke for veibeskrivelse -->
        <div style="margin-top:26px;">
          <div class="kart">
            <MapEmbed src={googleEmbed} title="Kart over avdelingskontoret (Google Maps)" />
          </div>
          <p class="muted" style="font-size:12.5px; margin-top:8px; display:flex; align-items:center; gap:6px;">
            <span aria-hidden="true" style="display:inline-flex; color:var(--rod);"><Icon name="map-pin" size={15} /></span>
            {KONTAKT.adresse}, {KONTAKT.postnummer} {KONTAKT.poststed} ·
            <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn-link" style="font-size:12.5px;" data-en="Open in Google Maps ↗">Åpne i Google Maps ↗</a>
          </p>
        </div>
      </div>

      <!-- SKJEMA -->
      <div class="card card-pad">
        <h2 class="h2" style="font-size:clamp(20px,2.4vw,26px); margin-bottom:16px;" data-en="Send us a message">Send oss en melding</h2>

        <div id="k-suksess" style="display:none; align-items:flex-start; gap:12px;" class="alert alert-green">
          <span class="ic">✓</span>
          <p style="font-size:14.5px;" data-en="Thank you! Your message has been sent. We'll get back to you.">
            Takk! Meldingen er sendt. Vi tar kontakt med deg.
          </p>
        </div>
        <div id="k-feil" style="display:none; align-items:flex-start; gap:12px;" class="alert alert-error">
          <span class="ic">×</span>
          <p id="k-feil-tekst" style="font-size:14.5px;"></p>
        </div>

        <form class="form-stack" id="hk-form" novalidate>
          <input type="text" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true"
            style="position:absolute; left:-9999px; width:1px; height:1px; opacity:0;" />
          <div class="field">
            <label for="hk-navn" data-en="Name">Navn</label>
            <input class="input" type="text" id="hk-navn" name="navn" placeholder="Ola Nordmann" data-en-ph="John Smith" required autocomplete="name" />
            <div class="field-error" id="hkerr-navn" style="display:none;"></div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="hk-epost" data-en="Email">E-post</label>
              <input class="input" type="email" id="hk-epost" name="epost" placeholder="ola@epost.no" data-en-ph="john@email.com" required autocomplete="email" />
              <div class="field-error" id="hkerr-epost" style="display:none;"></div>
            </div>
            <div class="field">
              <label for="hk-telefon" data-en="Phone">Telefon</label>
              <input class="input" type="tel" id="hk-telefon" name="telefon" placeholder="900 00 000" autocomplete="tel" />
            </div>
          </div>
          <div class="field">
            <label for="hk-gjelder" data-en="What is it about?">Hva gjelder det?</label>
            <select class="input" id="hk-gjelder" name="gjelder">
              <option data-en="Membership / join">Medlemskap / bli medlem</option>
              <option data-en="Pay & agreements">Lønn & tariff</option>
              <option data-en="Shop steward / workplace">Tillitsvalgt / arbeidsplass</option>
              <option data-en="Cabin rental">Hyttebooking</option>
              <option data-en="Other">Annet</option>
            </select>
          </div>
          <div class="field">
            <label for="hk-melding" data-en="Message">Melding</label>
            <textarea class="input" id="hk-melding" name="melding" rows="4" placeholder="Skriv din melding her…" data-en-ph="Write your message here…" required></textarea>
            <div class="field-error" id="hkerr-melding" style="display:none;"></div>
          </div>
          <!-- Spamvern (hCaptcha via Web3Forms) -->
          <div class="field">
            <div class="h-captcha" data-captcha="true"></div>
            <div class="field-error" id="hkerr-captcha" style="display:none;"></div>
          </div>
          <button class="btn btn-primary btn-block" type="submit" id="hk-submit" data-en="Send message">Send melding</button>
        </form>
      </div>

    </div>

    <!-- LOKALKONTORER -->
    <div class="section" style="padding-top:0;">
      <span class="eyebrow" data-en="Our offices">Våre kontorer</span>
      <h2 class="h2" style="margin:6px 0 10px;" data-en="We are in three places on Helgeland">Vi er tre steder på Helgeland</h2>
      <p class="muted" style="font-size:16px; max-width:62ch; margin-bottom:22px;"
         data-en="Mo i Rana is our main office. In Sandnessjøen and Mosjøen you will find our organisers, who work flexible hours — call or email ahead to make sure someone is in.">
        Mo i Rana er hovedkontoret vårt. I Sandnessjøen og Mosjøen finner du organisasjons&shy;arbeiderne
        våre, som har fleksitid — ring eller send en e-post på forhånd, så du er sikker på å treffe noen.
      </p>
      <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:18px;">
        {KONTORER.map(k => (
          <div class="card card-pad">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
              <span aria-hidden="true" style="display:inline-flex; color:var(--rod);"><Icon name="map-pin" size={17} /></span>
              <h3 class="h3" style="font-size:18px;">{k.sted}</h3>
              {k.hovedkontor && (
                <span class="badge badge-gul" style="margin-left:auto; font-size:11.5px;" data-en="Main office">Hovedkontor</span>
              )}
            </div>

            <p class="muted" style="font-size:14.5px; line-height:1.6;">
              {k.adresse}{'adresseTillegg' in k && k.adresseTillegg ? <><br />{k.adresseTillegg}</> : null}<br />
              {k.postnummer} {k.poststed}
            </p>
            <a href={kartUrl(k)} target="_blank" rel="noopener noreferrer" class="btn-link" style="font-size:13.5px; display:inline-block; margin-top:6px;" data-en="Show on map ↗">Vis i kart ↗</a>

            {'kontaktperson' in k && k.kontaktperson && (
              <p style="font-size:14px; margin-top:14px;">
                <b data-en="Contact">Kontaktperson</b><br />
                <span class="muted">{k.kontaktperson}</span>
              </p>
            )}

            <p style="font-size:14px; margin-top:14px;">
              <a href={`tel:+47${k.telefon}`} class="btn-link">{k.telefonFormatert}</a><br />
              <a href={`mailto:${k.epost}`} class="btn-link" style="word-break:break-all;">{k.epost}</a>
            </p>

            <p class="muted" style="font-size:13.5px; margin-top:14px; line-height:1.55;">
              <b style="color:var(--tekst);" data-en="Opening hours">Åpningstider</b><br />
              <span data-en={k.apningstider_en}>{k.apningstider}</span>
            </p>
          </div>
        ))}
      </div>
    </div>

  </div>

  <!-- hCaptcha-widget (spamvern på kontaktskjemaet) via Web3Forms-klient -->
  <script is:inline src="https://web3forms.com/client/script.js" async defer></script>
</Layout>

<script>
  import { oversett } from '../i18n/klient.ts';
  const form    = document.getElementById('hk-form') as HTMLFormElement | null;
  const suksess = document.getElementById('k-suksess');
  const feilBoks= document.getElementById('k-feil');
  const feilTxt = document.getElementById('k-feil-tekst');
  const submit  = document.getElementById('hk-submit');
  
  function setFeil(id: string, t: string) {
    const el = document.getElementById(id);
    if (el) { el.textContent = t; (el as HTMLElement).style.display = t ? '' : 'none'; }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    setFeil('hkerr-navn', ''); setFeil('hkerr-epost', ''); setFeil('hkerr-melding', ''); setFeil('hkerr-captcha', '');
    if (feilBoks) feilBoks.style.display = 'none';

    const navn    = (document.getElementById('hk-navn') as HTMLInputElement).value.trim();
    const epost   = (document.getElementById('hk-epost') as HTMLInputElement).value.trim();
    const telefon = (document.getElementById('hk-telefon') as HTMLInputElement).value.trim();
    const gjelder = (document.getElementById('hk-gjelder') as HTMLSelectElement).value;
    const melding = (document.getElementById('hk-melding') as HTMLTextAreaElement).value.trim();

    let ok = true;
    if (!navn)  { setFeil('hkerr-navn', oversett('Oppgi navn.', 'Enter your name.')); ok = false; }
    if (!epost || !epost.includes('@')) { setFeil('hkerr-epost', oversett('Oppgi gyldig e-post.', 'Enter a valid email.')); ok = false; }
    if (!melding) { setFeil('hkerr-melding', oversett('Skriv en melding.', 'Write a message.')); ok = false; }
    const capEl = form?.querySelector('textarea[name="h-captcha-response"]') as HTMLTextAreaElement | null;
    const capToken = capEl ? capEl.value : '';
    if (capEl && !capToken) { setFeil('hkerr-captcha', oversett('Fullfør captcha-en.', 'Please complete the captcha.')); ok = false; }
    if (!ok) return;

    const key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
    submit?.setAttribute('disabled', 'true');

    try {
      const resp = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: key,
          subject: `Avd. 143 kontakt — ${gjelder} — ${navn}`,
          from_name: navn,
          email: epost,
          message: `Fra: ${navn}\nE-post: ${epost}\nTelefon: ${telefon || '–'}\nGjelder: ${gjelder}\n\n${melding}`,
          'h-captcha-response': capToken,
        }),
      });
      const data = await resp.json();
      if (data.success) {
        form.style.display = 'none';
        if (suksess) suksess.style.display = 'flex';
      } else throw new Error(data.message);
    } catch {
      submit?.removeAttribute('disabled');
      if (feilTxt) feilTxt.textContent = oversett('Det oppstod en feil. Prøv igjen eller ring oss.', 'Something went wrong. Please try again or call us.');
      if (feilBoks) feilBoks.style.display = 'flex';
    }
  });
</script>

<style>
  .kart { aspect-ratio: 16 / 10; border-radius: 4px; overflow: hidden; border: 1px solid var(--kantlinje); }
</style>
