---
import Layout from '../layouts/Layout.astro';
import Bilde from '../components/Bilde.astro';
import CircleMotif from '../components/CircleMotif.astro';
import Icon from '../components/Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Reelle avtaleområder i Fellesforbundet. MERK: hvilken overenskomst som
// gjelder den enkelte arbeidsplass må bekreftes av avdelingen.
const avtaler = [
  { navn: 'Industrioverenskomsten', navn_en: 'The Industry Agreement',      omr: 'Verksted, smelteverk og prosessindustri', omr_en: 'Workshop, smelting and process industry' },
  { navn: 'Byggfagene', navn_en: 'The Building Trades Agreement',                  omr: 'Tømrer, betong og anlegg',                 omr_en: 'Carpentry, concrete and construction' },
  { navn: 'Byggeindustrien', navn_en: 'The Construction Industry Agreement',             omr: 'Industriell produksjon til byggenæringen', omr_en: 'Industrial production for the construction sector' },
  { navn: 'Riksavtalen', navn_en: 'The National Agreement (hospitality)',                 omr: 'Hotell, restaurant og servering',          omr_en: 'Hotel, restaurant and catering' },
  { navn: 'Biloverenskomsten', navn_en: 'The Motor Trade Agreement',           omr: 'Bilverksteder og transport',               omr_en: 'Car workshops and transport' },
  { navn: 'Glassoverenskomsten', navn_en: 'The Glass Agreement',         omr: 'Glass, fasade og montering',               omr_en: 'Glass, facade and installation' },
  { navn: 'Havbruksoverenskomsten', navn_en: 'The Aquaculture Agreement',      omr: 'Settefisk, matfisk og slakteri',           omr_en: 'Smolt, food fish and processing' },
  { navn: 'AIB-overenskomsten', navn_en: 'The Asphalt, Industry and Mining Agreement',          omr: 'Asfalt, industri og bergverk',             omr_en: 'Asphalt, industry and mining' },
  { navn: 'Gartnerioverenskomsten', navn_en: 'The Horticulture Agreement',      omr: 'Gartneri og hagebruk',                     omr_en: 'Horticulture and market gardening' },
  { navn: 'Avisoverenskomsten', navn_en: 'The Newspaper Agreement',          omr: 'Avis, trykk og distribusjon',              omr_en: 'Newspapers, printing and distribution' },
  { navn: 'Overenskomst for grafisk', navn_en: 'The Graphic Industry Agreement',    omr: 'Grafisk produksjon og emballasje',         omr_en: 'Graphic production and packaging' },
  { navn: 'VTA-overenskomsten', navn_en: 'The Sheltered Employment (VTA) Agreement',          omr: 'Varig tilrettelagt arbeid',                omr_en: 'Sheltered employment (VTA)' },
];

// Minstelønnssatser er ikke i arbeidsmiljøloven selv, men i allmenngjørings-
// forskriftene som Tariffnemnda fastsetter med hjemmel i allmenngjøringsloven.
// Arbeidstilsynet har den oppdaterte oversikten over gjeldende satser.
const LOVLENKER = {
  minstelonn: 'https://www.arbeidstilsynet.no/lonn-og-ansettelse/lonn/minstelonn/',
  allmenngjoring: 'https://lovdata.no/dokument/NL/lov/1993-06-04-58',
  aml: 'https://lovdata.no/dokument/NL/lov/2005-06-17-62',
};

const ressurser = [
  { ikon: 'file-text', tittel: 'Hva er en tariffavtale?', tittel_en: 'What is a collective agreement?', body: 'En avtale mellom fagforening og arbeidsgiver om lønn, arbeidstid og rettigheter.', body_en: 'An agreement between union and employer on pay, working hours and rights.' },
  { ikon: 'heart-handshake', tittel: 'Krev tariffavtale',        tittel_en: 'Demand an agreement',             body: 'Mangler arbeidsplassen din avtale? Ta kontakt, så hjelper avdelingen deg videre.', body_en: 'No agreement at your workplace? Get in touch and the branch will help you.' },
  { ikon: 'message-circle', tittel: 'Spørsmål om lønn?',        tittel_en: 'Questions about pay?',            body: 'Usikker på om du får det du har krav på? Avdelingen svarer deg.', body_en: 'Unsure if you get what you are entitled to? The branch will answer you.' },
];
---

<Layout
  title="Lønn & tariff — Fellesforbundet Helgeland avd. 143"
  titleEn="Pay & agreements — Fellesforbundet Helgeland branch 143"
  description="Tariffavtaler, lønn og rettigheter for medlemmer i Fellesforbundet avd. 143. Avtaleområder i industri, bygg, transport og service på Helgeland."
  ogImage="/images/og/og-tariff.jpg"
  ogImageAlt="Markering med faner i Mo i Rana"
>

  <!-- HERO -->
  <div class="hero-dark">
    <CircleMotif variant="mork-gul" class="hero-motif" />
    <div class="container section">
      <div class="hero-grid" style="align-items:center;">
        <div>
          <span class="hero-pill" data-en="Pay & agreements">Lønn & tariff</span>
          <h1 class="h1" style="margin-top:18px;" data-en="Pay, agreements and your rights">Lønn, tariff og dine rettigheter</h1>
          <p class="lead" style="max-width:52ch; margin-top:20px;"
             data-en="The collective agreement is your safety net at work — it secures minimum pay, supplements, working hours and the right to negotiate.">
            Tariffavtalen er sikkerhetsnettet ditt på jobb — den sikrer minstelønn, tillegg,
            arbeidstid og retten til å forhandle.
          </p>
        </div>
        <div class="hero-img">
          <Bilde sti="hovedside/ff-industri.png" alt="Illustrasjon: industriarbeid" altEn="Illustration: industrial work" bredde={1200} hoyde={675} sizes="(max-width: 900px) 100vw, 600px" prioritert style="width:100%; height:100%; object-fit:cover;" />
        </div>
      </div>
    </div>
  </div>

  <div class="container">

    <!-- AVTALEOMRÅDER -->
    <div class="section">
      <span class="eyebrow" data-en="Agreement areas">Avtaleområder</span>
      <h2 class="h2" style="margin:6px 0 10px;" data-en="Agreements in the branch">Avtaler i avdelingen</h2>
      <p class="muted" style="font-size:16px; max-width:60ch; margin-bottom:22px;"
         data-en="Examples of agreement areas our members work under. Unsure which applies to your workplace? Contact the branch.">
        Eksempler på avtaleområder medlemmene våre jobber under. Usikker på hvilken som gjelder
        din arbeidsplass? Kontakt avdelingen.
      </p>
      <div class="card card-pad">
        {avtaler.map(a => (
          <div class="list-row">
            <b data-en={a.navn_en}>{a.navn}</b>
            <span data-en={a.omr_en}>{a.omr}</span>
          </div>
        ))}
      </div>
      <div class="alert alert-warn" style="margin-top:18px;">
        <span class="ic">!</span>
        <div style="font-size:14.5px; line-height:1.6;"
             data-en="Minimum rates and supplements follow the current agreement and are adjusted at each wage settlement. The branch can tell you what applies to you.">
          Minstesatser og tillegg følger gjeldende overenskomst og justeres ved hvert lønnsoppgjør.
          Avdelingen kan fortelle deg hva som gjelder for deg.
        </div>
      </div>

      <!-- MINSTELØNN -->
      <div class="card card-pad" style="margin-top:18px;">
        <h3 class="h3" style="font-size:18px; margin-bottom:8px;" data-en="Minimum wage — what the law says">Minstelønn — hva loven sier</h3>
        <p class="muted" style="font-size:14.5px; line-height:1.65;"
           data-en="Norway has no general statutory minimum wage. In several industries a minimum rate is nevertheless made binding for everyone through the general application regulations, whether or not you are a union member. Arbeidstilsynet keeps the current rates.">
          Norge har ingen generell lovfestet minstelønn. I flere bransjer er en minstesats likevel
          gjort bindende for alle gjennom allmenn&shy;gjørings&shy;forskriftene — enten du er organisert
          eller ikke. Arbeidstilsynet holder oversikt over gjeldende satser.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:18px; margin-top:14px;">
          <a href={LOVLENKER.minstelonn} target="_blank" rel="noopener noreferrer" class="btn-link" style="font-size:14px;" data-en="Minimum wage rates (Arbeidstilsynet) ↗">Minstelønnssatser (Arbeidstilsynet) ↗</a>
          <a href={LOVLENKER.aml} target="_blank" rel="noopener noreferrer" class="btn-link" style="font-size:14px;" data-en="The Working Environment Act (Lovdata) ↗">Arbeidsmiljøloven (Lovdata) ↗</a>
          <a href={LOVLENKER.allmenngjoring} target="_blank" rel="noopener noreferrer" class="btn-link" style="font-size:14px;" data-en="The General Application Act (Lovdata) ↗">Allmenngjøringsloven (Lovdata) ↗</a>
        </div>
      </div>
    </div>

    <!-- RESSURSER -->
    <div class="section" style="padding-top:0;">
      <span class="eyebrow" data-en="Resources & help">Ressurser og hjelp</span>
      <h2 class="h2" style="margin:6px 0 32px;" data-en="Good to know">Bra å vite</h2>
      <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:18px;">
        {ressurser.map(r => (
          <div class="benefit">
            <span class="benefit-ic" aria-hidden="true"><Icon name={r.ikon} size={22} /></span>
            <h3 class="h3" style="font-size:18px; margin-bottom:6px;" data-en={r.tittel_en}>{r.tittel}</h3>
            <p class="muted" style="font-size:14.5px; line-height:1.6;" data-en={r.body_en}>{r.body}</p>
          </div>
        ))}
      </div>
      <div class="cta-band" style="margin-top:32px;">
        <div>
          <h2 class="h2" style="color:#fff; font-size:clamp(22px,2.6vw,30px); max-width:22ch;" data-en="Questions about pay or agreements?">Spørsmål om lønn eller tariff?</h2>
          <p style="color:#dcdce8; font-size:16px; margin-top:10px; max-width:46ch; line-height:1.6;"
             data-en="The branch helps members with pay, agreements and rights at work.">
            Avdelingen hjelper medlemmer med lønn, avtaler og rettigheter på jobb.
          </p>
        </div>
        <a href={`${base}/kontakt`} class="btn btn-primary" data-en="Contact the branch →">Kontakt avdelingen →</a>
      </div>
    </div>

  </div>
</Layout>
