---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

// Fontene importeres for å få tak i den hashede URL-en, slik at de kan
// forhåndslastes. Uten det oppdages de først når nettleseren har parset CSS-en,
// og teksten rekker å tegnes med reservefonten før den byttes — det var det som
// ga utseendeforskyvning (CLS) på forsiden.
import interWoff2 from '../fonts/inter-latin.woff2?url';
import spaceGroteskWoff2 from '../fonts/space-grotesk-latin.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  canonical?: string;
  lang?: string;
  noindex?: boolean;
}

// Delingsbilder ligger i /images/og/ og lages av `npm run og`
// (scripts/gen-og-bilder.mjs). Sider som handler om hytteutleie, medlemskap
// eller tariff sender inn sitt eget bilde — resten deler avdelingsbildet.
const {
  title,
  description,
  ogImage = '/images/og/og-default.jpg',
  ogImageAlt = 'Fellesforbundet Helgeland avd. 143 — 1. mai-tog med fanen gjennom Mo i Rana',
  ogType = 'website',
  lang = 'no',
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = siteUrl + Astro.url.pathname;
const ogImageUrl = siteUrl + base + ogImage;

// Brødsmule: «Forsiden / [side]» på undersider (fellesforbundet.no-mønster).
const sti = Astro.url.pathname.replace(base, '').replace(/^\/|\/$/g, '');
const sideNavn: Record<string, { no: string; en: string }> = {
  'bli-medlem':      { no: 'Bli medlem',          en: 'Join' },
  'lonn-tariff':     { no: 'Lønn & tariff',       en: 'Pay & agreements' },
  'tillitsvalgte':   { no: 'Tillitsvalgte',       en: 'Shop stewards' },
  'nyttige-lenker':  { no: 'Nyttige lenker',      en: 'Useful links' },
  'aktuelt':         { no: 'Aktuelt',             en: 'News' },
  'om-oss':          { no: 'Om oss',              en: 'About us' },
  'kontakt':         { no: 'Kontakt',             en: 'Contact' },
  'hytter':          { no: 'Hytteutleie',         en: 'Cabin rental' },
  'umbukta':         { no: 'Hytte i Umbukta',     en: 'Umbukta cabin' },
  'turtips':         { no: 'Turtips Umbukta',     en: 'Hiking tips (Umbukta)' },
  'hjelp':           { no: 'Hjelp – hytteutleie', en: 'Help – cabin rental' },
  'personvern':      { no: 'Personvern',          en: 'Privacy' },
  'cookies':         { no: 'Cookies',             en: 'Cookies' },
  'vilkar':          { no: 'Vilkår',              en: 'Terms' },
  'tilgjengelighet': { no: 'Tilgjengelighet',     en: 'Accessibility' },
  'takk':            { no: 'Takk',                en: 'Thank you' },
};
const brodsmule = sideNavn[sti];
// Sider som åpner med mørk hero (eller bildehero) → navy brødsmule m/hvit tekst,
// så den smelter sammen med seksjonen under. Øvrige sider er lyse (gjennomsiktig).
const morkeHero = new Set([
  'bli-medlem', 'lonn-tariff', 'tillitsvalgte', 'aktuelt',
  'om-oss', 'kontakt', 'hytter', 'turtips', 'umbukta',
]);
const brodsmuleMork = morkeHero.has(sti);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#1A1836" />

  {/* Fontene lastes samtidig med HTML-en i stedet for etter CSS-parsing.
      crossorigin er påkrevd selv om fontene er på eget domene — fonter hentes
      i CORS-modus, og uten flagget lastes de to ganger. */}
  <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={spaceGroteskWoff2} as="font" type="font/woff2" crossorigin />

  <!-- Content-Security-Policy. GitHub Pages kan ikke sette HTTP-headere, så
       policyen leveres via meta. 'unsafe-inline' er nødvendig fordi siden bruker
       inline style-attributter og define:vars-skript overalt. Eksterne hoster
       er begrenset til det siden faktisk bruker — oppdater ved nye integrasjoner:
       img-src (Statens vegvesen-webkamera + hCaptcha), frame-src (Google Maps +
       Facebook + hCaptcha), connect-src (Yr + Web3Forms + hCaptcha), script-src
       (Web3Forms-klient + hCaptcha). NB: Cloudflare Web Analytics er IKKE med.
       Den ble prøvd 7. sep. 2026, men Cloudflare injiserte aldri beaconen, så
       den samler ikke inn noe. Skrus den på senere, må
       static.cloudflareinsights.com inn i script-src og cloudflareinsights.com
       i connect-src — og den må beskrives på /personvern og /cookies.
       connect-src MÅ ha 'self' — kalender/booking
       henter availability.json fra eget domene, og connect-src overstyrer default-src.
       hCaptcha (spamvern på skjemaene) laster fra hcaptcha.com/*.hcaptcha.com, og
       widget-scriptet fra web3forms.com. NB: frame-ancestors/sandbox ignoreres i
       meta-CSP og settes ikke her. -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https://kamera.atlas.vegvesen.no https://*.hcaptcha.com; font-src 'self'; style-src 'self' 'unsafe-inline' https://hcaptcha.com https://*.hcaptcha.com; script-src 'self' 'unsafe-inline' https://web3forms.com https://hcaptcha.com https://*.hcaptcha.com; connect-src 'self' https://api.met.no https://api.web3forms.com https://hcaptcha.com https://*.hcaptcha.com; frame-src https://www.google.com https://maps.google.com https://www.facebook.com https://hcaptcha.com https://*.hcaptcha.com; form-action 'self' https://api.web3forms.com" />

  <!-- Tittel og meta -->
  <title>{title}</title>
  <meta name="description" content={description} />
  {/* Canonical utelates på noindex-sider: å peke en side Google ikke skal
      indeksere til seg selv er et motstridende signal, og på 404-siden ville
      den pekt på /404/, som ikke finnes som URL. */}
  {!noindex && <link rel="canonical" href={canonicalUrl} />}
  {noindex && <meta name="robots" content="noindex,follow" />}

  <!-- Open Graph -->
  <meta property="og:type"        content={ogType} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url"         content={canonicalUrl} />
  <meta property="og:image"        content={ogImageUrl} />
  <meta property="og:image:secure_url" content={ogImageUrl} />
  <meta property="og:image:type"   content="image/jpeg" />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"    content={ogImageAlt} />
  <meta property="og:locale"       content="nb_NO" />
  <meta property="og:locale:alternate" content="en_GB" />
  <meta property="og:site_name"    content="Fellesforbundet Helgeland avd. 143" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImageUrl} />
  <meta name="twitter:image:alt"   content={ogImageAlt} />

  <!-- Schema.org Organisation -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Fellesforbundet Helgeland avd. 143",
    "url": siteUrl + base,
    "logo": siteUrl + base + "/images/logo/ff_logo_hvit_rgb-01.png",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+47-75151228",
      "contactType": "customer service",
      "availableLanguage": ["Norwegian", "English"]
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Søndre gate 13",
      "addressLocality": "Mo i Rana",
      "postalCode": "8624",
      "addressCountry": "NO"
    }
  })} />

  <!-- Favicon og web app manifest -->
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  <link rel="manifest" href={`${base}/site.webmanifest`} />
</head>
<body>
  <a class="skip-link" href="#main-content" data-en="Skip to content">Hopp til innhold</a>
  <Header />

  {/* Vises bare når den besøkende har valgt et annet språk enn norsk. Norsk er
      avdelingens offisielle tekst — oversettelsene er ikke kvalitetssikret, og
      det må stå tydelig på en side som forklarer lønn, rettigheter og vilkår.
      Selve notisen oversettes som all annen tekst (data-en + ordbok). */}
  <div class="sprak-notis" id="sprak-notis" role="status" hidden>
    <div class="container sprak-notis-inner">
      <span class="sprak-notis-ic" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><path d="M12 7.6v.4" />
        </svg>
      </span>
      <p data-en="Norwegian is the branch's official version. Translations are not quality assured. If anything is unclear about pay, rights or terms, the Norwegian text applies — or contact the branch.">
        Norsk er avdelingens offisielle versjon. Oversettelsene er ikke kvalitetssikret.
        Er noe uklart om lønn, rettigheter eller vilkår, er det den norske teksten som
        gjelder — eller ta kontakt med avdelingen.
      </p>
      <button type="button" id="sprak-notis-norsk" class="sprak-notis-knapp" data-en="Show in Norwegian">Vis på norsk</button>
      <button type="button" id="sprak-notis-lukk" class="sprak-notis-lukk" aria-label="Lukk" data-en-ph="Close">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>
  {brodsmule && (
    <nav class={`brodsmule${brodsmuleMork ? ' brodsmule--mork' : ''}`} aria-label="Du er her">
      <div class="container">
        <a href={`${base}/`} data-en="Home">Forsiden</a>
        <span class="brodsmule-sep" aria-hidden="true">/</span>
        <span class="brodsmule-na" data-en={brodsmule.en}>{brodsmule.no}</span>
      </div>
    </nav>
  )}
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <CookieConsent />

  <!-- Varsel før man forlater avdelingens nettside til en ekstern side -->
  <div class="ext-modal" id="ext-modal" role="dialog" aria-modal="true" aria-labelledby="ext-tittel" aria-describedby="ext-tekst">
    <div class="ext-modal-overlay" aria-hidden="true"></div>
    <div class="ext-modal-box">
      <div class="ext-modal-ic" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </div>
      <h2 id="ext-tittel" data-en="You are leaving our website">Du forlater avdelingens nettside</h2>
      <p id="ext-tekst" data-en="You are being sent to an external website that the branch does not control:">Du sendes nå til en ekstern nettside som avdelingen ikke har kontroll over:</p>
      <strong class="ext-host" id="ext-host"></strong>
      <div class="ext-actions">
        <button type="button" class="btn btn-primary" id="ext-go" data-en="Continue to the site">Fortsett til siden</button>
        <button type="button" class="btn btn-secondary" id="ext-cancel" data-en="Cancel">Avbryt</button>
      </div>
    </div>
  </div>

  <!-- Språkbytte-skript (initialiseres fra lagret localStorage-preferanse) -->
  <script>
    import { translations } from '../i18n/translations.ts';
    import { ORDBOKER, AKTIVE_SPRAK, type Sprakkode } from '../i18n/sprak.ts';
    import { oversett as oversettKlient, locale as localeKlient } from '../i18n/klient.ts';

    // Skript som bruker define:vars blir klassiske inline-skript og kan ikke
    // importere noe (se BookingForm, WeatherWidget og takk). De når hjelperne
    // her i stedet. Dette skriptet er en modul og kjører etter dem, så de må
    // tåle at window.ffhI18n ennå ikke finnes — de faller da tilbake til norsk
    // og tegnes på nytt av «sprakendret» rett etter.
    (window as typeof window & { ffhI18n?: unknown }).ffhI18n = {
      oversett: oversettKlient,
      locale: localeKlient,
    };

    // Norsk ligger i HTML-en. Engelsk ligger ved siden av, i data-en. Alle
    // andre språk slås opp i en ordbok på den norske teksten — da trenger vi
    // ikke ett attributt per språk på hvert eneste element (det ville blitt
    // over to tusen). Mangler en tekst i ordboka, faller den tilbake til norsk.
    const HTML_LANG: Record<string, string> = Object.fromEntries(
      AKTIVE_SPRAK.map(s => [s.kode, s.htmlLang]),
    );
    const NAVN: Record<string, string> = Object.fromEntries(
      AKTIVE_SPRAK.map(s => [s.kode, s.navn]),
    );

    // Original (norsk) innhold, slik at vi alltid kan slå opp og bytte tilbake.
    const noHtml = new WeakMap<HTMLElement, string>();
    const noPh   = new WeakMap<HTMLInputElement | HTMLTextAreaElement, string>();

    // Ordboknøkkelen er den norske teksten med normalisert mellomrom, slik at
    // innrykk i HTML-en ikke gjør oppslaget avhengig av formatering.
    const nokkel = (s: string) => s.replace(/\s+/g, ' ').trim();

    function slaOpp(norsk: string, lang: Sprakkode): string {
      if (lang === 'nb') return norsk;
      const ordbok = ORDBOKER[lang];
      const treff = ordbok?.[nokkel(norsk)];
      return treff && treff.trim() !== '' ? treff : norsk;
    }

    function applyLang(lang: Sprakkode) {
      const t = translations[lang as 'nb' | 'en'] ?? translations.nb;
      const nb = translations.nb;

      // 1) Delte strenger med nøkkel (nav, overskrifter, skjemaetiketter).
      document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n') as keyof typeof nb;
        if (!key || !(key in nb)) return;
        el.textContent = lang === 'nb' || lang === 'en' ? t[key] : slaOpp(nb[key], lang);
      });
      document.querySelectorAll<HTMLElement>('[data-i18n-placeholder]').forEach(el => {
        const key = el.getAttribute('data-i18n-placeholder') as keyof typeof nb;
        if (!key || !(key in nb)) return;
        if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
          el.placeholder = lang === 'nb' || lang === 'en' ? t[key] : slaOpp(nb[key], lang);
        }
      });

      // 2) Tekst som står inline i HTML-en. Norsk caches ved første kjøring.
      document.querySelectorAll<HTMLElement>('[data-en]').forEach(el => {
        if (!noHtml.has(el)) noHtml.set(el, el.innerHTML);
        const norsk = noHtml.get(el) ?? '';
        el.innerHTML = lang === 'nb' ? norsk
          : lang === 'en' ? (el.getAttribute('data-en') ?? norsk)
          : slaOpp(norsk, lang);
      });
      document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-en-ph]').forEach(el => {
        if (!noPh.has(el)) noPh.set(el, el.placeholder);
        const norsk = noPh.get(el) ?? '';
        el.placeholder = lang === 'nb' ? norsk
          : lang === 'en' ? (el.getAttribute('data-en-ph') ?? norsk)
          : slaOpp(norsk, lang);
      });

      document.documentElement.lang = HTML_LANG[lang] ?? 'no';

      // Notis om at norsk er den offisielle teksten. Vises på alt annet enn
      // norsk, med mindre den besøkende har lukket den i denne fanen.
      const notis = document.getElementById('sprak-notis');
      if (notis) {
        let lukket = false;
        try { lukket = sessionStorage.getItem('sprak-notis-lukket') === '1'; } catch { /* privat vindu */ }
        notis.hidden = lang === 'nb' || lukket;
      }

      // Oppdater begge varianter av språkvelgeren (flaggrad og nedtrekksmeny).
      document.querySelectorAll<HTMLElement>('.lang button').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.lang === lang);
      });
      document.querySelectorAll<HTMLElement>('.lang-liste button').forEach(btn => {
        btn.setAttribute('aria-selected', String(btn.dataset.lang === lang));
      });
      const navnEl  = document.getElementById('lang-knapp-navn');
      const flaggEl = document.getElementById('lang-knapp-flagg');
      const valgt   = document.querySelector<HTMLElement>(`.lang-liste button[data-lang="${lang}"]`);
      if (navnEl) navnEl.textContent = NAVN[lang] ?? 'Norsk';
      if (flaggEl && valgt?.querySelector('svg')) {
        flaggEl.innerHTML = valgt.querySelector('svg')!.outerHTML;
      }

      try { localStorage.setItem('lang', lang); } catch { /* privat vindu */ }

      // Si fra til skript som tegner opp eget innhold (kalender, værwidget,
      // datoer). De skal IKKE lytte på klikk i språkvelgeren selv — markupen
      // der er ulik med to og med flere språk.
      document.dispatchEvent(new CustomEvent('sprakendret', { detail: lang }));
    }

    let lagret: string | null = null;
    try { lagret = localStorage.getItem('lang'); } catch { /* privat vindu */ }
    // Et språk kan ha blitt slått av igjen etter at noen valgte det.
    const gyldig = AKTIVE_SPRAK.some(s => s.kode === lagret);
    applyLang((gyldig ? lagret : 'nb') as Sprakkode);

    document.querySelectorAll<HTMLElement>('.lang button, .lang-liste button').forEach(btn => {
      btn.addEventListener('click', () => {
        applyLang((btn.dataset.lang as Sprakkode) || 'nb');
        lukkMeny();
      });
    });

    // ── Språknotisen ───────────────────────────────────────────────────
    document.getElementById('sprak-notis-lukk')?.addEventListener('click', () => {
      const notis = document.getElementById('sprak-notis');
      if (notis) notis.hidden = true;
      // Bare for denne fanen — notisen kommer igjen ved nytt besøk.
      try { sessionStorage.setItem('sprak-notis-lukket', '1'); } catch { /* privat vindu */ }
    });

    document.getElementById('sprak-notis-norsk')?.addEventListener('click', () => {
      applyLang('nb');
    });

    // ── Nedtrekksmenyen ────────────────────────────────────────────────
    const knapp = document.getElementById('lang-knapp');
    const liste = document.getElementById('lang-liste');

    function lukkMeny() {
      if (!liste || !knapp) return;
      liste.hidden = true;
      knapp.setAttribute('aria-expanded', 'false');
    }

    knapp?.addEventListener('click', e => {
      e.stopPropagation();
      if (!liste) return;
      const apen = !liste.hidden;
      liste.hidden = apen;
      knapp.setAttribute('aria-expanded', String(!apen));
      if (!apen) liste.querySelector<HTMLElement>('button[aria-selected="true"]')?.focus();
    });

    document.addEventListener('click', e => {
      if (liste && !liste.hidden && !liste.contains(e.target as Node) && e.target !== knapp) lukkMeny();
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && liste && !liste.hidden) { lukkMeny(); knapp?.focus(); }
    });
  </script>

  <!-- FAQ-accordion (global) -->
  <script>
    document.querySelectorAll('.acc-head').forEach(btn => {
      btn.addEventListener('click', () => {
        btn.closest('.acc-item')?.classList.toggle('open');
      });
    });
  </script>

  <!-- «Meny»-knapp → full meny (alle skjermstørrelser) -->
  <script>
    const toggle = document.getElementById('nav-toggle');
    const navMobile = document.getElementById('nav-mobile');
    const header = document.querySelector('.site-header');

    // Full-menyen starter rett under headeren — sett høyden dynamisk (topp-rad
    // + hovedrad varierer med skjermbredde).
    function settHeaderHoyde() {
      if (header) document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px');
    }
    settHeaderHoyde();
    window.addEventListener('resize', settHeaderHoyde);

    function lukkMeny() {
      navMobile?.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
    toggle?.addEventListener('click', () => {
      settHeaderHoyde();
      const open = navMobile?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(!!open));
    });
    navMobile?.querySelectorAll('a').forEach(a => a.addEventListener('click', lukkMeny));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') lukkMeny(); });
  </script>

  <!-- Ekstern-lenke-varsel: fang klikk på lenker til andre domener og bekreft først -->
  <script>
    (function () {
      const modal   = document.getElementById('ext-modal');
      const hostEl  = document.getElementById('ext-host');
      const goBtn   = document.getElementById('ext-go') as HTMLButtonElement | null;
      const cancel  = document.getElementById('ext-cancel');
      const overlay = modal?.querySelector('.ext-modal-overlay');
      let pending: { url: string; nyFane: boolean } | null = null;

      function erEkstern(a: HTMLAnchorElement): boolean {
        const href = a.getAttribute('href') || '';
        if (/^(mailto:|tel:|#|javascript:)/i.test(href)) return false;
        let u: URL;
        try { u = new URL(a.href, location.href); } catch { return false; }
        if (u.protocol !== 'http:' && u.protocol !== 'https:') return false;
        return u.hostname !== location.hostname;
      }

      function lukk() { modal?.classList.remove('open'); pending = null; }

      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const a = t.closest?.('a[href]') as HTMLAnchorElement | null;
        if (!a || !erEkstern(a)) return;
        e.preventDefault();
        pending = { url: a.href, nyFane: a.target === '_blank' };
        if (hostEl) hostEl.textContent = new URL(a.href).hostname.replace(/^www\./, '');
        modal?.classList.add('open');
        goBtn?.focus();
      });

      goBtn?.addEventListener('click', () => {
        if (!pending) return;
        const { url, nyFane } = pending;
        lukk();
        if (nyFane) window.open(url, '_blank', 'noopener');
        else location.href = url;
      });
      cancel?.addEventListener('click', lukk);
      overlay?.addEventListener('click', lukk);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') lukk(); });
    })();
  </script>
</body>
</html>
